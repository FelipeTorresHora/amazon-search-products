# =============================================================================
# AMAZON SEARCH PRODUCTS - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Amazon Search Products"
APP_VERSION="1.0.0"
ENVIRONMENT=development  # development, staging, production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
API_V1_PREFIX=/api/v1

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/amazon_search
DB_HOST=db
DB_PORT=5432
DB_NAME=amazon_search
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_ECHO=false  # Set to true to see SQL queries in logs

# =============================================================================
# REDIS (Cache & Celery Broker)
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600  # 1 hour in seconds

# =============================================================================
# CELERY (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false  # Set to true in tests
CELERY_TASK_SOFT_TIME_LIMIT=300  # 5 minutes
CELERY_TASK_TIME_LIMIT=600  # 10 minutes

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-this-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_COOKIE_NAME=refresh_token
JWT_REFRESH_TOKEN_COOKIE_SECURE=false  # Set to true in production with HTTPS

# =============================================================================
# CORS (Frontend URLs)
# =============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:8501","http://localhost:3000","http://localhost:8000"]
FRONTEND_URL=http://localhost:8501

# =============================================================================
# AMAZON REAL-TIME DATA API (RapidAPI)
# =============================================================================
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com
RAPIDAPI_BASE_URL=https://real-time-amazon-data.p.rapidapi.com
AMAZON_API_RATE_LIMIT=1000  # requests per month
AMAZON_API_DELAY=1  # seconds between requests

# =============================================================================
# STRIPE (Payment Processing)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=BRL
STRIPE_SUCCESS_URL=http://localhost:8501/success
STRIPE_CANCEL_URL=http://localhost:8501/cancel

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_BUSINESS=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxxxxxxxxxxx

# =============================================================================
# EMAIL (SendGrid)
# =============================================================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@amazonanalytics.com.br
SENDGRID_FROM_NAME="Amazon Analytics"
EMAIL_TEMPLATES_DIR=./email_templates

# =============================================================================
# AWS (Storage & Infrastructure)
# =============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=amazon-search-products-data
AWS_CLOUDFRONT_DOMAIN=https://d1234567890.cloudfront.net

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE=/var/log/amazon-search/app.log

# =============================================================================
# RATE LIMITING (per minute)
# =============================================================================
RATE_LIMIT_FREE=10
RATE_LIMIT_PRO=100
RATE_LIMIT_BUSINESS=1000
RATE_LIMIT_ENTERPRISE=10000

# =============================================================================
# USAGE LIMITS (per month)
# =============================================================================
USAGE_LIMIT_FREE_SEARCHES=50
USAGE_LIMIT_FREE_ALERTS=5
USAGE_LIMIT_PRO_SEARCHES=1000
USAGE_LIMIT_PRO_ALERTS=50
USAGE_LIMIT_BUSINESS_SEARCHES=5000
USAGE_LIMIT_BUSINESS_ALERTS=200

# =============================================================================
# ADMIN
# =============================================================================
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis123!
FIRST_SUPERUSER_NAME="Admin User"

# =============================================================================
# TESTING
# =============================================================================
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amazon_search_test
TEST_REDIS_URL=redis://localhost:6379/15

# =============================================================================
# DOCKER
# =============================================================================
COMPOSE_PROJECT_NAME=amazon-search-products
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=1000
WORKER_PREFETCH_MULTIPLIER=4

# =============================================================================
# STREAMLIT
# =============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME_PRIMARY_COLOR=#FF4B4B
STREAMLIT_THEME_BACKGROUND_COLOR=#FFFFFF
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_OAUTH_ENABLED=false
FEATURE_2FA_ENABLED=false
FEATURE_API_PUBLIC_ACCESS=false
FEATURE_WEBHOOKS_ENABLED=false
FEATURE_WHITE_LABEL=false

# =============================================================================
# METRICS & ANALYTICS
# =============================================================================
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# =============================================================================
# ELASTICSEARCH (Optional - for advanced search)
# =============================================================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=products

# =============================================================================
# SECURITY
# =============================================================================
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]
SECURE_SSL_REDIRECT=false  # Set to true in production
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false

# =============================================================================
# BACKUP
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM (cron format)
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=amazon-search-backups
